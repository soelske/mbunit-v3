<Project Sdk="Microsoft.NET.Sdk">

 <PropertyGroup>
   <TargetFramework>net8.0-windows</TargetFramework>
   <UseWindowsForms>true</UseWindowsForms>
   <AssemblyName>Gallio</AssemblyName>
   <RootNamespace>Gallio</RootNamespace>
   <Version>4.0.0</Version>
   <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
   <GenerateDocumentationFile>true</GenerateDocumentationFile>
   <PackageId>Gallio.V4</PackageId>
   <Authors>Gallio Project, Bart Suelze</Authors>
   <Description>Gallio Test Automation Platform v4 - Now with .NET 8 support! Multi-target package supporting .NET Framework 3.5+ and .NET 8.</Description>
   <PackageTags>testing;test-framework;gallio;mbunit;unit-testing;automation;dotnet;csharp</PackageTags>
   <PackageProjectUrl>https://github.com/soelske/mbunit-v3</PackageProjectUrl>
   <RepositoryUrl>https://github.com/soelske/mbunit-v3</RepositoryUrl>
   <RepositoryType>git</RepositoryType>
   <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
   <PackageReadmeFile>README.md</PackageReadmeFile>
   <PackageIcon>Pillar.png</PackageIcon>
   <Copyright>Copyright © 2005-2025 Gallio Project</Copyright>
   <!-- Source files hebben allemaal expliciete usings; disable voorkomt Timer-ambiguïteit -->
  <ImplicitUsings>disable</ImplicitUsings>
   <Nullable>enable</Nullable>
   <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  <!-- Alle .cs komen via expliciete wildcards buiten de projectmap;
       SDK auto-include veroorzaakt duplicates via de Link-virtuele paden. -->
  <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
 </PropertyGroup>

 <ItemGroup>
  <Compile Include="..\Gallio\**\*.cs" Link="%(RecursiveDir)%(Filename)%(Extension)" />
  <EmbeddedResource Include="..\Gallio\**\*.resx" Link="%(RecursiveDir)%(Filename)%(Extension)" />
 </ItemGroup>

  <ItemGroup>
    <!-- Exclude auto-generated files and build output -->
    <Compile Remove="..\Gallio\obj\**\*.cs" />
    <Compile Remove="..\Gallio\bin\**\*.cs" />

    <!-- Exclude files that still depend on Microsoft.Cci.* (no .NET 8 NuGet equivalent) -->
    <Compile Remove="..\Gallio\Common\Reflection\Impl\CciDebugSymbolResolver.cs" />
    <Compile Remove="..\Gallio\Common\Reflection\Impl\CciModuleCache.cs" />

    <!-- Exclude Unresolved* types: .NET 8–compatible replacements live in this project directory -->
    <Compile Remove="..\Gallio\Common\Reflection\Impl\UnresolvedAssembly.cs" />
    <Compile Remove="..\Gallio\Common\Reflection\Impl\UnresolvedCodeElementFactory.cs" />
    <Compile Remove="..\Gallio\Common\Reflection\Impl\UnresolvedCodeElementFactoryInternal.cs" />
    <Compile Remove="..\Gallio\Common\Reflection\Impl\UnresolvedConstructorInfo.cs" />
    <Compile Remove="..\Gallio\Common\Reflection\Impl\UnresolvedCustomAttributeProvider.cs" />
    <Compile Remove="..\Gallio\Common\Reflection\Impl\UnresolvedEventInfo.cs" />
    <Compile Remove="..\Gallio\Common\Reflection\Impl\UnresolvedFieldInfo.cs" />
    <Compile Remove="..\Gallio\Common\Reflection\Impl\UnresolvedMemberInfo.cs" />
    <Compile Remove="..\Gallio\Common\Reflection\Impl\UnresolvedMethodBase.cs" />
    <Compile Remove="..\Gallio\Common\Reflection\Impl\UnresolvedMethodInfo.cs" />
    <Compile Remove="..\Gallio\Common\Reflection\Impl\UnresolvedParameterInfo.cs" />
    <Compile Remove="..\Gallio\Common\Reflection\Impl\UnresolvedPropertyInfo.cs" />
    <Compile Remove="..\Gallio\Common\Reflection\Impl\UnresolvedType.cs" />

    <!-- DebugSymbolUtils / ReflectorResolveUtils: replacements live in this project directory -->
    <Compile Remove="..\Gallio\Common\Reflection\Impl\DebugSymbolUtils.cs" />
    <Compile Remove="..\Gallio\Common\Reflection\Impl\ReflectorResolveUtils.cs" />

    <!-- .NET Remoting channel files: replacements (Named Pipes / TCP) live in this project directory -->
    <Compile Remove="..\Gallio\Common\Remoting\BaseChannel.cs" />
    <Compile Remove="..\Gallio\Common\Remoting\BaseClientChannel.cs" />
    <Compile Remove="..\Gallio\Common\Remoting\BaseServerChannel.cs" />
    <Compile Remove="..\Gallio\Common\Remoting\BinaryIpcClientChannel.cs" />
    <Compile Remove="..\Gallio\Common\Remoting\BinaryIpcServerChannel.cs" />
    <Compile Remove="..\Gallio\Common\Remoting\BinaryTcpClientChannel.cs" />
    <Compile Remove="..\Gallio\Common\Remoting\BinaryTcpServerChannel.cs" />

    <!-- Security: WindowsImpersonationContext removed from .NET 8; replacement in this project directory -->
    <Compile Remove="..\Gallio\Common\Security\Impersonation.cs" />

    <!-- CallContext removed from .NET 8; replacement uses AsyncLocal<T> in this project directory -->
    <Compile Remove="..\Gallio\Model\Contexts\DefaultTestContextTracker.cs" />

    <!-- [OneWay] from System.Runtime.Remoting.Messaging removed; replacement in this project directory -->
    <Compile Remove="..\Gallio\Runtime\ProgressMonitoring\RemoteProgressMonitor.cs" />

    <!-- BinaryFormatter obsoleted; JSON replacement lives in this project directory -->
    <Compile Remove="..\Gallio\Common\Messaging\MessageFormatters\BinaryMessageFormatter.cs" />

    <!-- AppDomainUtils / DefaultElevationManager: replacements live in this project directory -->
    <Compile Remove="..\Gallio\Runtime\Hosting\AppDomainUtils.cs" />
    <Compile Remove="..\Gallio\Runtime\Security\DefaultElevationManager.cs" />

    <!-- IsolatedAppDomainHost(Factory): AppDomain APIs removed; excluded until fully replaced -->
    <Compile Remove="..\Gallio\Runtime\Hosting\IsolatedAppDomainHostFactory.cs" />
    <Compile Remove="..\Gallio\Runtime\Hosting\IsolatedAppDomainHost.cs" />

    <!-- ConfigureForDebugging: .NET 8 variant in this project directory -->
    <Compile Remove="..\Gallio\Runtime\DefaultRuntime.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Include all replacement .cs files in this project directory -->
    <Compile Include="**\*.cs" Exclude="obj\**\*.cs;bin\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Not via CopyToOutputDirectory — would propagate to all ProjectReference dependents; copied via Target below instead. -->
    <None Include="..\Gallio\Gallio.plugin" Link="Gallio.plugin" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Include icon resources as Content -->
    <Content Include="..\Gallio\Resources\*.ico" Link="Resources\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Gallio\Resources\Pillar.png" Pack="true" PackagePath="\" Link="Resources\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\Revision.cs" Link="Revision.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- SharpZipLib: vervangt lokale ICSharpCode.SharpZipLib.dll -->
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
    <!-- Mono.Cecil: vervangt lokale Mono.Cecil.dll -->
    <PackageReference Include="Mono.Cecil" Version="0.11.5" />
    <!-- App.config ondersteuning -->
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.1" />
    <!-- System.Drawing op niet-Windows platforms -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />

    <!--
      Gallio.ReflectionShim: lokale shim-assembly voor .NET 2.0 reflectie.
    -->
    <Reference Include="Gallio.ReflectionShim">
      <HintPath>..\Gallio\libs\Gallio.ReflectionShim.dll</HintPath>
      <Private>true</Private>
    </Reference>

    <!--
      Microsoft.Cci.*: oude CCI metadata-assemblies, geen .NET 8 NuGet beschikbaar.
    -->
    <Reference Include="Microsoft.Cci.MetadataHelper">
      <HintPath>..\Gallio\libs\CciMetadata\Bin\Microsoft.Cci.MetadataHelper.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.Cci.MetadataModel">
      <HintPath>..\Gallio\libs\CciMetadata\Bin\Microsoft.Cci.MetadataModel.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.Cci.PdbReader">
      <HintPath>..\Gallio\libs\CciMetadata\Bin\Microsoft.Cci.PdbReader.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.Cci.PeReader">
      <HintPath>..\Gallio\libs\CciMetadata\Bin\Microsoft.Cci.PeReader.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.Cci.SourceModel">
      <HintPath>..\Gallio\libs\CciMetadata\Bin\Microsoft.Cci.SourceModel.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!-- Copy plugin file to THIS project's output only. -->
  <Target Name="CopyPluginToOutput" AfterTargets="Build">
    <Copy SourceFiles="..\Gallio\Gallio.plugin"
          DestinationFiles="$(OutputPath)Gallio.plugin"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- Post-build event to create multi-target package in Release mode -->
  <Target Name="CreateMultiTargetPackage" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <ProjectDirTrimmed>$(ProjectDir.TrimEnd('\'))</ProjectDirTrimmed>
    </PropertyGroup>
    <Message Text="Creating multi-target NuGet package..." Importance="high" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(ProjectDirTrimmed)\Build-MultiTarget-Package.ps1&quot; -ProjectDir &quot;$(ProjectDirTrimmed)&quot; -Configuration &quot;$(Configuration)&quot; -PackageId &quot;$(PackageId)&quot; -Version &quot;$(Version)&quot;" 
          WorkingDirectory="$(ProjectDirTrimmed)"
          ContinueOnError="true" 
          IgnoreExitCode="true" />
  </Target>

</Project>
