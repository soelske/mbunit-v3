<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
  <!-- Multi-target build -->
  <TargetFramework>net8.0-windows</TargetFramework>
  <UseWindowsForms>true</UseWindowsForms>
	<AssemblyName>MbUnit</AssemblyName>
	<RootNamespace>MbUnit</RootNamespace>
	<Version>4.0.0</Version>
  <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  <GenerateDocumentationFile>true</GenerateDocumentationFile>
	<PackageId>MbUnit.V4</PackageId>
	<Authors>Gallio Project, Bart Suelze</Authors>
	<Description>MbUnit Test Framework v4 - Now with .NET 8 support! Multi-target package supporting .NET Framework 3.5+ and .NET 8.</Description>
	<PackageTags>testing;test-framework;mbunit;unit-testing;tdd;bdd;automation;dotnet;csharp</PackageTags>
	<PackageProjectUrl>https://github.com/soelske/mbunit-v3</PackageProjectUrl>
	<RepositoryUrl>https://github.com/soelske/mbunit-v3</RepositoryUrl>
	<RepositoryType>git</RepositoryType>
	<PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
	<PackageReadmeFile>README.md</PackageReadmeFile>
	<PackageIcon>MbUnit.png</PackageIcon>
	<Copyright>Copyright © 2005-2025 Gallio Project</Copyright>
  <ImplicitUsings>enable</ImplicitUsings>
  <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
	  <Compile Include="..\MbUnit\**\*.cs" Link="%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Include icon resources as Content -->
    <Content Include="..\MbUnit\Resources\*.*" Link="Resources\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\MbUnit\Resources\MbUnit.png" Pack="true" PackagePath="\" Link="Resources\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\MbUnit\MbUnit.plugin" Link="MbUnit.plugin" CopyToOutputDirectory="PreserveNewest" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exclude auto-generated files and build output -->
    <Compile Remove="..\MbUnit\obj\**\*.cs" />
    <Compile Remove="..\MbUnit\bin\**\*.cs" />
    
    <!-- Exclude files that don't compile in .NET 8 -->
    <Compile Remove="..\MbUnit\Framework\Assert.Serialization.cs" />
    <Compile Remove="..\MbUnit\Framework\Assert.That.cs" />
    <Compile Remove="..\MbUnit\Framework\ImpersonateAttribute.cs" />
    <Compile Remove="..\MbUnit\Framework\ContractVerifiers\Core\ImmutableTypeCollection.cs" />
    <Compile Remove="..\MbUnit\Framework\ContractVerifiers\ExceptionContract.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\Revision.cs" Link="Revision.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NHamcrest" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Gallio\Gallio.Core\Gallio.Core.csproj" />
  </ItemGroup>

  <!-- Post-build event to create multi-target package in Release mode -->
  <Target Name="CreateMultiTargetPackage" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <ProjectDirTrimmed>$(ProjectDir.TrimEnd('\'))</ProjectDirTrimmed>
    </PropertyGroup>
    <Message Text="Creating multi-target NuGet package..." Importance="high" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(ProjectDirTrimmed)\Build-MultiTarget-Package.ps1&quot; -ProjectDir &quot;$(ProjectDirTrimmed)&quot; -Configuration &quot;$(Configuration)&quot; -PackageId &quot;$(PackageId)&quot; -Version &quot;$(Version)&quot;" 
          ContinueOnError="true" 
          IgnoreExitCode="true" />
  </Target>

</Project>
