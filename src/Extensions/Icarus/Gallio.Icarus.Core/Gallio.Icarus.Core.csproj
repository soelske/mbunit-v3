<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Gallio.Icarus</AssemblyName>
    <RootNamespace>Gallio.Icarus</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>1591</NoWarn>
    <!-- Wildcards outside project directory require explicit includes -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <ApplicationIcon>..\Gallio.Icarus\Resources\Gallio.Icarus.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- All original Icarus source via wildcard -->
  <ItemGroup>
    <Compile Include="..\Gallio.Icarus\**\*.cs" Link="%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\Gallio.Icarus\**\*.resx" Link="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Exclusions for files that need .NET 8 replacements -->
  <ItemGroup>
    <Compile Remove="..\Gallio.Icarus\obj\**\*.cs" />
    <Compile Remove="..\Gallio.Icarus\bin\**\*.cs" />

    <!-- ICSharpCode.TextEditor removed; RichTextBox replacements live in this project directory -->
    <Compile Remove="..\Gallio.Icarus\Views\CodeViewer\CodeViewer.cs" />
    <Compile Remove="..\Gallio.Icarus\Views\CodeViewer\CodeViewer.Designer.cs" />

    <!-- DockPanel.Skin API removed in DockPanelSuite v3; replacement in this project directory -->
    <Compile Remove="..\Gallio.Icarus\Main.Designer.cs" />

    <!-- ConfigureTestRunnerFactory: null-guard + Local fallback added; replacement in this project directory -->
    <Compile Remove="..\Gallio.Icarus\IcarusProgram.cs" />

    <!-- SetupReportMenus: warning item when Gallio.Reports.dll ontbreekt; replacement in this project directory -->
    <Compile Remove="..\Gallio.Icarus\Main.cs" />

    <!-- GenerateReport: silent skip + Runtime Log warning when Gallio.Reports.dll ontbreekt; replacement in this project directory -->
    <Compile Remove="..\Gallio.Icarus\Controllers\ReportController.cs" />

    <!-- AnnotationsController: toont Warning annotation wanneer Gallio.Reports.dll ontbreekt; replacement in this project directory -->
    <Compile Remove="..\Gallio.Icarus\Annotations\AnnotationsController.cs" />

    <!-- DockPanel.config filename changed to DockPanel3.config (v2/v3 schema incompatibility); replacement in this project directory -->
    <Compile Remove="..\Gallio.Icarus\Paths.cs" />

    <!-- ProjectTreeModel.GetChildren: report directory resolved via testProject.ReportDirectory (relative to project file), not hardcoded "Reports"; replacement in this project directory -->
    <Compile Remove="..\Gallio.Icarus\Models\ProjectTreeModel.cs" />

    <!-- ProjectExplorerView.OpenReport: UseShellExecute=true required in .NET 8 to open files via associated application; replacement in this project directory -->
    <Compile Remove="..\Gallio.Icarus\ProjectExplorer\ProjectExplorerView.cs" />

    <!-- ReportMonitor.SetupDirectoryWatcher: FileSystemWatcher.Filter with multi-wildcard glob unreliable in .NET 8; use "*.xml" + Regex match instead; replacement in this project directory -->
    <Compile Remove="..\Gallio.Icarus\Reports\ReportMonitor.cs" />

    <!-- ProjectController.ReportDirectory: resolves relative ReportDirectory against project file location so reports are saved to the watched directory regardless of CWD; replacement in this project directory -->
    <Compile Remove="..\Gallio.Icarus\Controllers\ProjectController.cs" />

    <!-- OptionsController: IProjectTreeModel dependency + per-project TestRunnerFactory restore/save; replacement in this project directory -->
    <Compile Remove="..\Gallio.Icarus\Controllers\OptionsController.cs" />

    <!-- PluginPreferencesSynchronizer: PreloadPreferenceManagerAssemblies added to force lazy plugin assembly load before reflection scan; replacement in this project directory -->
    <Compile Remove="..\Gallio.Icarus\Projects\PluginPreferencesSynchronizer.cs" />
  </ItemGroup>

  <!-- Replacement files in this project directory -->
  <ItemGroup>
    <Compile Include="**\*.cs" Exclude="obj\**\*.cs;bin\**\*.cs" />
  </ItemGroup>

  <!-- Shared Revision.cs -->
  <ItemGroup>
    <Compile Include="..\Revision.cs" Link="Revision.cs" />
  </ItemGroup>

  <!-- Plugin descriptor — not via CopyToOutputDirectory; copied via Target below instead. -->
  <ItemGroup>
    <None Include="..\Gallio.Icarus\Gallio.Icarus.plugin" Link="Gallio.Icarus.plugin" />
  </ItemGroup>

  <!-- Icarus resource files loaded from disk at runtime -->
  <ItemGroup>
    <Content Include="..\Gallio.Icarus\Resources\*.*" Link="Resources\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Aga.Controls: no .NET 8 NuGet, local DLL via HintPath -->
    <Reference Include="Aga.Controls">
      <HintPath>..\..\..\Gallio\libs\Aga.Controls.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <!-- DockPanelSuite v3 replaces WeifenLuo.WinFormsUI.Docking v2 -->
    <PackageReference Include="DockPanelSuite" Version="3.1.1" />
    <PackageReference Include="DockPanelSuite.ThemeVS2015" Version="3.1.1" />
    <!-- App.config support -->
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Gallio\Gallio.Core\Gallio.Core.csproj" />
    <ProjectReference Include="..\..\..\Gallio\Gallio.UI.Core\Gallio.UI.Core.csproj" />
    <!-- Build-only dependency: ensures Reports.Core (and NVelocity.dll) is built before NSIS runs.
         ReferenceOutputAssembly=false: geen compile-time referentie, output niet naar Icarus kopiëren. -->
    <ProjectReference Include="..\..\..\Gallio\Gallio.Reports.Core\Gallio.Reports.Core.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <!-- Copy plugin files to THIS project's output.
       Lokaal (Debug + Release): ConfigureForDebugging detecteert de src\-tree en vindt
       alle plugins automatisch in hun eigen project outputs.
       Voor de NSIS installer: *.plugin en *.dll worden via wildcards uit deze output gepakt.
       AutoCAD bestanden worden door de installer rechtstreeks uit de AutoCAD project outputs gehaald. -->
  <Target Name="CopyPluginToOutput" AfterTargets="Build">
    <Copy SourceFiles="..\Gallio.Icarus\Gallio.Icarus.plugin"
          DestinationFiles="$(OutputPath)Gallio.Icarus.plugin"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="..\..\..\Gallio\Gallio\Gallio.plugin"
          DestinationFiles="$(OutputPath)Gallio.plugin"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="..\..\..\Gallio\Gallio.UI\Gallio.UI.plugin"
          DestinationFiles="$(OutputPath)Gallio.UI.plugin"
          SkipUnchangedFiles="true" />
    <!-- MbUnit is een zelfstandige plugin in Plugins\MbUnit\; installer haalt
         MbUnit.dll en MbUnit.plugin rechtstreeks uit MbUnit.Core output. -->
  </Target>

  <!-- Build NSIS setup automatically on Release builds.
       Vereist: NSIS geïnstalleerd in %ProgramFiles(x86)%\NSIS\
                Omgevingsvariabelen XX_PROGS en XX_SETUP ingesteld. -->
  <Target Name="BuildNsisSetup" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <Message Text="Building NSIS setup (Release)..." Importance="high" />
    <Exec Command="cmd.exe /c &quot;$(MSBuildThisFileDirectory)Setup\compile-setup.bat&quot;"
          WorkingDirectory="$(MSBuildThisFileDirectory)Setup"
          ContinueOnError="WarnAndContinue" />
  </Target>

</Project>
