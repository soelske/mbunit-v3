<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>Gallio.AutoCAD.Plugin250</RootNamespace>
    <AssemblyName>Gallio.AutoCAD.Plugin250</AssemblyName>
    <Version>4.0.0</Version>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <OutputPath>bin\v25.0\</OutputPath>
    <DefineConstants>TRACE;DEBUG;R25</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <OutputPath>bin\v25.0\</OutputPath>
    <DefineConstants>TRACE;R25</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <!-- Exclude files that are not compatible with .NET 8 or will be replaced -->
    <Compile Remove="..\Gallio.AutoCAD.Plugin\packages.config" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Revision.cs" Link="Revision.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="AutoCAD.NET.Core" Version="25.1.0" />
    <PackageReference Include="AutoCAD.NET.Model" Version="25.1.0" />
    <PackageReference Include="AutoCAD.NET" Version="25.1.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\Gallio\Gallio.Core\Gallio.Core.csproj" />
    <ProjectReference Include="..\Gallio.AutoCAD.Core\Gallio.AutoCAD.Core.csproj" />
  </ItemGroup>
</Project>
